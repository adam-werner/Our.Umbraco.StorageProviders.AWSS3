{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": false
      },
      "Content": {
        "MacroErrors": "Throw"
      },
      "Hosting": {
        "Debug": true
      },
      "ModelsBuilder": {
        "ModelsMode": "SourceCodeManual"
      }
    },
    "Storage": {
      "AWSS3": {
        "Media": {
          "BucketName": "[Your Bucket]"
        }
      }
    }
  },
  "AWS": {
    "Profile": "[Your Profile]",
    "Region": "[Your Region]"
  }
}
